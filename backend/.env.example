# Database (must be Postgres with the pgvector extension available —
# e.g. the pgvector/pgvector:pg16 Docker image, or Supabase/Neon which
# both ship pgvector already)
DATABASE=postgresql://everafter:everafter@localhost:5432/everafter
DATABASE_URL=postgresql://neondb_owner:npg_3gipGxl2CqaD@ep-empty-river-azige64o.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# CORS
CORS_ORIGINS=http://localhost:3000

# Email (SMTP) for OTP verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=10

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# AI Chat — OpenRouter (free-tier model), OpenAI-compatible
# Get a key at https://openrouter.ai/keys — free models don't require billing
OPENAI_API_KEY=your-openrouter-api-key
OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Embeddings — local, free, no API key. First run downloads ~90MB once.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# RAG tuning
RAG_CHUNK_SIZE_CHARS=1000
RAG_CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=5
